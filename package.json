{
  "name": "husa-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "test": "node --test tests/content.test.mjs",
    "format": "prettier --write src tests scripts/verify-build.mjs astro.config.mjs",
    "format:check": "prettier --check src tests scripts/verify-build.mjs astro.config.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0"
}
