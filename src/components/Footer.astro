---
import { navigation, site, branches } from '../content/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand brand-footer" href="/" aria-label="HUSA home">
        <img src="/images/husa-seal.webp" width="76" height="76" alt="" />
        <span>
          <strong>HUSA</strong>
          <span>
            Howard University
            <br />
            Student Association
          </span>
        </span>
      </a>
      <p>Executive Branch · {site.administration}</p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        {navigation.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
        <li>
          <a href="/events/">Events</a>
        </li>
      </ul>
    </div>
    <div>
      <h2>Stay connected</h2>
      <ul>
        <li>
          <a href={site.instagram}>Instagram</a>
        </li>
        <li>
          <a href={site.linktree}>Linktree</a>
        </li>
      </ul>
    </div>
    <div>
      <h2>Get in touch</h2>
      <p>
        {site.office}
        <br />
        {site.address}
      </p>
      <a href={`tel:+1${site.phone.replaceAll('-', '')}`}>
        Hotline: {site.phone}
      </a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <p>Office hours: {site.officeHours}</p>
    </div>
  </div>
  <nav class="branch-bar" aria-label="HUSA branches">
    <div class="container">
      {branches.map((branch) => (
        <a href={branch.href}>{branch.title}</a>
      ))}
    </div>
  </nav>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Howard University Student Association</p>
  </div>
</footer>
