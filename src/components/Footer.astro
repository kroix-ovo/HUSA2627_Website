---
import { navigation, site, branches } from '../content/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand brand-footer" href="/" aria-label="HUSA home">
        <img src="/images/husa-seal.webp" width="76" height="76" alt="" />
        <span>
          <strong>HUSA</strong>
          <span>
            Howard University
            <br />
            Student Association
          </span>
        </span>
      </a>
      <p>Your voice. Your student government.</p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        {navigation.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
        <li>
          <a href="/events/">Events</a>
        </li>
      </ul>
    </div>
    <div>
      <h2>Get in touch</h2>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:+1${site.phone.replaceAll('-', '')}`}>{site.phone}</a>
      <p>{site.address}</p>
      <a href={site.instagram}>Instagram · @husassociation</a>
      <a href={site.linktree}>HUSA Linktree</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Howard University Student Association</p>
    <div>
      {branches.map((branch) => (
        <a href={branch.href}>{branch.title}</a>
      ))}
    </div>
  </div>
</footer>
