---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Your voice, your resources, your student government. Explore the Howard University Student Association.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | HUSA</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#081B45" />
    <!-- Preview remains out of search indexes until the production domain and content are approved. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/webp" href="/images/husa-seal.webp" />
    <meta property="og:title" content={`${title} | HUSA`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
