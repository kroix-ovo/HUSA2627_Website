---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import OfficeList from '../../components/OfficeList.astro';
import Icon from '../../components/Icon.astro';
import { categories } from '../../content/resources';
import { site } from '../../content/site';
---

<Layout
  title="The Herd Hub"
  description="Find Howard campus resources, financial aid, housing support, wellness services, scholarships, and career guidance."
>
  <PageIntro
    title="The Herd Hub."
    section="Student resources"
    description="Whether you need academic support, financial assistance, housing resources, or wellness services, find the right place to start."
  >
    <div class="actions">
      <a class="button" href={site.caseCompass}>
        Get support with Case Compass <Icon />
      </a>
      <a class="text-link" href={site.linktree}>
        HUSA Linktree <Icon />
      </a>
    </div>
  </PageIntro>
  <section class="page-body">
    <div class="container">
      <div class="category-grid">
        {categories.map((category) => (
          <a class="category-link" href={`/resources/${category.slug}/`}>
            <h2>
              {category.name}
              <Icon />
            </h2>
            <p>{category.description}</p>
          </a>
        ))}
      </div>
      <div class="directory-heading">
        <h2>Find your campus office.</h2>
        <div class="filter-form">
          <label for="office-filter">Filter the directory</label>
          <input
            id="office-filter"
            type="search"
            placeholder="Try housing or financial aid"
            autocomplete="off"
          />
        </div>
      </div>
      <p
        class="filter-status"
        id="office-status"
        role="status"
        aria-live="polite"
      >
        Explore the campus directory below.
      </p>
      <OfficeList />
      <div class="empty-state" id="office-empty" hidden>
        <h3>No offices match that search.</h3>
        <p>
          Try a different term, or contact HUSA for help finding the right
          office.
        </p>
        <button class="button button-subtle" id="clear-offices" type="button">
          Clear search
        </button>
      </div>
      <div class="callout">
        <h2>Not sure where to turn?</h2>
        <p>
          The Case Compass Program connects students experiencing campus-related
          issues with direct support.
        </p>
        <a class="text-link" href={site.caseCompass}>
          Open the Case Compass form <Icon />
        </a>
      </div>
      <a class="text-link" href="https://howard.edu/">
        Visit the official Howard website <Icon />
      </a>
    </div>
  </section>
</Layout>
<script>
  import { matchesQuery } from '../../lib/search';
  const input = document.querySelector<HTMLInputElement>('#office-filter');
  const rows = Array.from(
    document.querySelectorAll<HTMLElement>('[data-office]'),
  );
  const status = document.querySelector<HTMLElement>('#office-status');
  const empty = document.querySelector<HTMLElement>('#office-empty');
  function filterOffices() {
    const query = input?.value ?? '';
    let count = 0;
    rows.forEach((row) => {
      const match = matchesQuery(row.dataset.search ?? '', query);
      row.hidden = !match;
      if (match) count++;
    });
    if (status)
      status.textContent = `${count} ${count === 1 ? 'office' : 'offices'} found.`;
    if (empty) empty.hidden = count !== 0;
  }
  input?.addEventListener('input', filterOffices);
  document.querySelector('#clear-offices')?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      filterOffices();
      input.focus();
    }
  });
</script>
