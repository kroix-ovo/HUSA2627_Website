---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import OfficeList from '../../components/OfficeList.astro';
import Icon from '../../components/Icon.astro';
import { categories, offices } from '../../content/resources';
import { site } from '../../content/site';
export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}
const { category } = Astro.props;
const related = offices.filter((office) =>
  office.categories.includes(category.slug),
);
---

<Layout title={category.name}>
  <PageIntro
    title={category.name}
    section="The Herd Hub"
    description={category.description}
  />
  <section class="page-body">
    <div class="container split-page">
      <div>
        <h2>Where to start</h2>
        <p class="section-description">
          Connect with the campus offices below for information and support.
        </p>
        <OfficeList items={related} />
        <a class="text-link" href="/resources/">
          Back to all resources <Icon />
        </a>
      </div>
      <aside class="side-panel">
        <h2>Need a hand?</h2>
        <p>
          Experiencing a campus-related issue? HUSA’s Case Compass Program
          offers a place to request support.
        </p>
        <a class="button" href={site.caseCompass}>
          Open Case Compass
        </a>
        <p style="margin-top:20px">
          For HUSA questions, email{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </aside>
    </div>
  </section>
</Layout>
