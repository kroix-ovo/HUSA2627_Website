---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import { site, leaders } from '../../content/site';
---

<Layout title="Meet HUSA 66">
  <PageIntro
    title="Meet HUSA 66."
    section="Executive leadership"
    description="The leadership behind the 66th Administration of the Howard University Student Association."
  />
  <section class="page-body">
    <div class="container">
      <div class="leadership-grid">
        {leaders.map((leader) => (
          <article class="leader">
            <p class="leader-role">{leader.role}</p>
            <h2>{leader.name}</h2>
            <p>{leader.role} · HUSA Executive Branch</p>
            <a class="button" href={`mailto:${site.email}`}>
              Contact the Executive Branch
            </a>
          </article>
        ))}
      </div>
      <div class="callout">
        <h2>Explore the teams behind the work.</h2>
        <p>
          Learn about each department’s responsibilities, leadership, and public
          contact details.
        </p>
        <a class="text-link" href="/departments/">
          Meet the departments <Icon />
        </a>
      </div>
    </div>
  </section>
</Layout>
