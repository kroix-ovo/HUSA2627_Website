---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../content/site';
---

<Layout title="Meet HUSA 66">
  <PageIntro
    title="Meet HUSA 66."
    section="Executive leadership"
    description="The leadership behind the 66th Administration of the Howard University Student Association."
  />
  <section class="page-body">
    <div class="container">
      <div class="leadership-grid">
        <article class="leader">
          <img
            src="/images/president-ware.webp"
            width="720"
            height="1085"
            alt="President Ware"
            loading="lazy"
          />
          <h2>President Ware</h2>
          <p>President · HUSA Executive Branch</p>
          <a class="button" href={`mailto:${site.email}`}>
            Contact the Executive Branch
          </a>
        </article>
        <article class="leader">
          <img
            src="/images/vice-president-garcia.webp"
            width="720"
            height="1090"
            alt="Vice President Garcia"
            loading="lazy"
          />
          <h2>Vice President Garcia</h2>
          <p>Vice President · HUSA Executive Branch</p>
          <a class="button" href={`mailto:${site.email}`}>
            Contact the Executive Branch
          </a>
        </article>
      </div>
      <div class="callout">
        <h2>Explore the teams behind the work.</h2>
        <p>
          Learn about each department’s responsibilities, leadership, and public
          contact details.
        </p>
        <a class="text-link" href="/departments/">
          Meet the departments <Icon />
        </a>
      </div>
    </div>
  </section>
</Layout>
