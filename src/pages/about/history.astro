---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
---

<Layout title="History of HUSA">
  <PageIntro
    title="A legacy of student voice."
    section="History of HUSA"
    description="Established in 1961, the Howard University Student Association has aimed to be a mechanism for effective change on campus."
  />
  <section class="page-body">
    <div class="container prose">
      <h2>Students at the center.</h2>
      <p>
        HUSA brings students’ interests and concerns into the university’s
        decision-making process and maintains communication across Howard’s
        schools and colleges.
      </p>
      <p>
        To share an archival record or learn more about HUSA’s history,{' '}
        <a href="/contact/">contact the Executive Branch</a>.
      </p>
      <a class="button" href="/about/">
        About HUSA
      </a>
    </div>
  </section>
</Layout>
