---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PathwaySlider from '../components/PathwaySlider.astro';
import { initiatives } from '../content/platform';
import { site } from '../content/site';

// Wix-style slideshow of HUA-style pathways. Each slide shows a different crop of
// the approved campus photo (see .slide-crop-* in global.css); no photos of people.
const pathways = [
  {
    title: 'Meet HUSA 66',
    text: 'Meet the students leading the 66th Administration and find out how to reach them.',
    href: '/about/leadership/',
    action: 'Leadership',
  },
  {
    title: 'Department Breakdown',
    text: 'The departments of the Executive Branch make up the cabinet. Each one is committed to reshaping what Howard University stands for.',
    href: '/departments/',
    action: 'Departments',
  },
  {
    title: 'The Herd Hub',
    text: 'Our resource hub, where students can find financial aid support, housing, and more.',
    href: '/resources/',
    action: 'Resources',
  },
];
---

<Layout title="Howard University Student Association">
  <section class="hero">
    <img
      class="hero-photo"
      src="/images/howard-campus.webp"
      width="1600"
      height="2400"
      alt="Aerial view of Howard University's campus and Founders Library"
      fetchpriority="high"
    />
    <div class="container hero-inner">
      <img
        class="hero-seal"
        src="/images/husa-seal.webp"
        width="120"
        height="120"
        alt=""
      />
      <p class="administration">{site.administration}</p>
      <h1>The Howard University Student Association</h1>
      <p class="hero-tagline">Official website</p>
      <div class="actions">
        <a class="button button-white" href="/resources/">
          Explore the Herd Hub <Icon />
        </a>
        <a class="button button-outline" href="/platform-tracker/">
          Track our impact
        </a>
      </div>
    </div>
  </section>

  <section class="section pathways reveal" aria-labelledby="pathways-title">
    <div class="container">
      <h2 id="pathways-title" class="visually-hidden">
        Start here
      </h2>
      <PathwaySlider label="Start here" slides={pathways} />
    </div>
  </section>

  <section class="section all-in reveal" aria-labelledby="all-in-title">
    <div class="container">
      <h2 id="all-in-title" class="slogan">
        When Howard Student Leaders go <em class="accent">ALL IN,</em>
        <span class="slogan-line">
          Howard Students <em class="accent">Win.</em>
        </span>
      </h2>
      <p class="slogan-text">
        This is more than a phrase; it’s a commitment, a vision and a
        responsibility.
      </p>
      <a class="button" href={site.platformTracker}>
        Track our impact! <Icon />
      </a>
    </div>
  </section>

  <section
    class="section section-gray reveal"
    aria-labelledby="initiatives-title"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="initiatives-title" class="title-bar">
            Current Initiatives
          </h2>
          <p class="section-description">
            The six pillars of the 66th Administration’s platform. Reported
            progress is kept in the{' '}
            <a href={site.platformTracker}>live ALL IN platform tracker</a>.
          </p>
        </div>
        <a class="text-link" href="/platform-tracker/">
          Explore our platform <Icon />
        </a>
      </div>
      <div class="platform-list">
        {initiatives.map((initiative, index) => (
          <a
            class="platform-row"
            href={`/platform-tracker/${initiative.slug}/`}
          >
            <span class="row-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{initiative.title}</h3>
              <p>{initiative.summary}</p>
            </div>
            <Icon />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="updates-title">
    <div class="container">
      <h2 id="updates-title" class="title-bar">
        Stay Updated
      </h2>
      <div class="updates-grid">
        <div class="updates-panel">
          <h3>Upcoming events</h3>
          <p>
            No upcoming dates are listed yet. Event dates are added here once
            they are confirmed.
          </p>
          <a class="text-link" href="/events/">
            Events & meetings <Icon />
          </a>
        </div>
        <div class="updates-panel updates-panel-dark">
          <h3>Follow @husassociation</h3>
          <p>
            HUSA’s Instagram has the latest announcements, events, and ways to
            take part.
          </p>
          <a class="button button-white" href={site.instagram}>
            Follow on Instagram <Icon />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    class="section section-gray reveal"
    aria-labelledby="take-part-title"
  >
    <div class="container">
      <h2 id="take-part-title" class="take-part-title">
        Take Part
      </h2>
      <div class="take-part-grid">
        <article class="take-part">
          <h3>Help us improve</h3>
          <p>
            Experiencing a campus-related issue? HUSA’s Case Compass Program
            gives you a direct way to request support. For anything else, email{' '}
            <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
          <a class="button" href={site.caseCompass}>
            Open Case Compass <Icon />
          </a>
        </article>
        <article class="take-part">
          <h3>Join the team</h3>
          <p>
            Want to contribute to HUSA? Find current opportunities, including
            the Public Relations staffer application, and other ways to get
            involved.
          </p>
          <a class="button" href="/get-involved/">
            Get involved <Icon />
          </a>
        </article>
      </div>
    </div>
  </section>
</Layout>
