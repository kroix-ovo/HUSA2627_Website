---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import JoinBanner from '../components/JoinBanner.astro';
import { categories } from '../content/resources';
import { initiatives } from '../content/platform';
---

<Layout title="Howard University Student Association">
  <section class="hero">
    <img
      class="hero-photo"
      src="/images/howard-campus.webp"
      width="1600"
      height="2400"
      alt="Aerial view of Howard University's campus and Founders Library"
      fetchpriority="high"
    />
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="administration">66th Administration</p>
        <h1>
          When we go <span class="all-in">ALL IN,</span>
          <br />
          Howard students win.
        </h1>
        <p>Your voice. Your resources. Your student government.</p>
        <div class="actions">
          <a class="button button-white" href="/resources/">
            Explore the Herd Hub <Icon />
          </a>
          <a class="button button-outline" href="/platform-tracker/">
            Track our impact
          </a>
        </div>
      </div>
    </div>
  </section>
  <div class="quick-links">
    <div class="container">
      <a href="/resources/">
        Student resources <Icon />
      </a>
      <a href="/about/leadership/">
        Meet HUSA 66 <Icon />
      </a>
      <a href="/get-involved/">
        Get involved <Icon />
      </a>
    </div>
  </div>
  <section class="section">
    <div class="container resource-preview">
      <div>
        <h2>
          Find your way.
          <br />
          We’re here to help.
        </h2>
        <p class="section-description">
          Housing, financial aid, opportunities, and more. Start with the Herd
          Hub.
        </p>
        <a class="text-link" href="/resources/">
          All student resources <Icon />
        </a>
      </div>
      <div class="resource-links">
        {categories.slice(0, 4).map((category) => (
          <a href={`/resources/${category.slug}/`}>
            <h3>
              {category.name} <Icon />
            </h3>
            <p>{category.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section section-gray">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-label">Our platform</p>
          <h2>
            A commitment. A plan.
            <br />A stronger Howard.
          </h2>
        </div>
        <a class="text-link" href="/platform-tracker/">
          Explore our platform <Icon />
        </a>
      </div>
      <div class="platform-list">
        {initiatives.map((initiative, index) => (
          <a
            class="platform-row"
            href={`/platform-tracker/${initiative.slug}/`}
          >
            <span class="row-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{initiative.title}</h3>
              <p>{initiative.summary}</p>
            </div>
            <Icon />
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="organization">
    <div class="organization-photo">
      <img
        src="/images/howard-campus.webp"
        width="1600"
        height="2400"
        alt="Founders Library and the Howard University campus"
        loading="lazy"
      />
    </div>
    <div class="organization-copy">
      <p class="section-label">Our organization</p>
      <h2>
        Meet the people
        <br />
        behind the work.
      </h2>
      <p>
        HUSA is the eyes, ears, and voice for the student body. We bring
        students’ interests and concerns into the university’s decision-making
        process.
      </p>
      <div class="actions">
        <a class="button" href="/about/leadership/">
          Meet HUSA 66
        </a>
        <a class="text-link" href="/departments/">
          Explore departments <Icon />
        </a>
      </div>
    </div>
  </section>
  <JoinBanner />
</Layout>
